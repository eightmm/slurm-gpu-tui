#!/usr/bin/env bash
# Convenience shim so ./chkgpu keeps working inside a git checkout.
# Installed systems get the real `chkgpu` console script from the venv;
# the code lives in src/sgpu/quickview.py.
here="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$here/.venv/bin/chkgpu" ]; then
    exec "$here/.venv/bin/chkgpu" "$@"
fi
exec "${SGPU_PYTHON:-python3}" -c \
    "import sys; sys.path.insert(0, '$here/src'); from sgpu.quickview import main; main()" "$@"
