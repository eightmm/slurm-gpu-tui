[Unit]
Description=sgpu autonomous node telemetry publisher
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=@SGPU_AGENT_BIN@ @SGPU_AGENT_DIR@
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=simple
Environment="SLURM_GPU_TUI_AGENT_DIR=@SGPU_AGENT_DIR@"
ExecStart=@SGPU_AGENT_BIN@ --mode @SGPU_NODE_MODE@
Restart=always
RestartSec=10
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
