[Unit]
Description=SLURM GPU Monitor Collector
After=network.target

[Service]
Type=simple
# install.sh rewrites both placeholders (see sgpu-cpu-agent.service for the
# same @NAME@ convention). Never commit a real path here — it leaks the
# maintainer's checkout and reads as if the unit should point at it.
User=@SGPU_USER@
ExecStart=@SGPU_VENV@/bin/sgpu-collector
# "always" (not on-failure): site cron sweeps like pkill -f python send
# SIGTERM, the collector exits 0, and on-failure would leave it dead.
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
