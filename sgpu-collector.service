[Unit]
Description=SLURM GPU Monitor Collector
After=network.target

[Service]
Type=simple
# Reference template. sgpu-install renders the local paths and environment.
User=@SGPU_USER@
ExecStart=@SGPU_PREFIX@/bin/sgpu-collector
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
